# SBOMAI AI Microservice Configuration
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=false

# AI Provider Configuration
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=60

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=4000
ANTHROPIC_TEMPERATURE=0.3

# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-pro
GOOGLE_MAX_TOKENS=4000
GOOGLE_TEMPERATURE=0.3

# Local Models
LOCAL_MODEL_PATH=./models
LOCAL_MODEL_TYPE=sentence-transformers
LOCAL_DEVICE=cpu

# ML Model Configuration
XGBOOST_N_ESTIMATORS=100
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_RANDOM_STATE=42

LIGHTGBM_N_ESTIMATORS=100
LIGHTGBM_MAX_DEPTH=6
LIGHTGBM_LEARNING_RATE=0.1
LIGHTGBM_RANDOM_STATE=42

MODEL_CACHE_DIR=./models
MODEL_AUTO_DOWNLOAD=true

# Service Configuration
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_WORKERS=10
GRPC_MAX_CONCURRENT_RPCS=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true

# Performance
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=300
CACHE_ENABLED=true
CACHE_TTL=3600

# Data Sources
NVD_API_KEY=your-nvd-api-key-here
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_RATE_LIMIT=5

OSS_INDEX_URL=https://ossindex.sonatype.org/api/v3/component-report
OSS_INDEX_USERNAME=your-oss-index-username
OSS_INDEX_TOKEN=your-oss-index-token

OSV_BASE_URL=https://api.osv.dev/v1

# Data Storage
DATA_DIR=./data
CACHE_DIR=./cache

# Security
ENABLE_AUTH=false
AUTH_TOKEN=your-auth-token-here
ALLOWED_ORIGINS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Input Validation
MAX_INPUT_SIZE=10485760
MAX_COMPONENTS_PER_REQUEST=1000

# Feature Flags
EXPLAIN_RISK=true
PREDICT_RISK=true
SUGGEST_FIX=true
EXPLAINABLE_CHAIN=true
LOCAL_MODELS=true
EXTERNAL_APIS=true
CACHING=true
METRICS=true 